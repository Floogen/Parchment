<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Version>1.5.0</Version>
		<TargetFramework>net6.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<EnableHarmony>true</EnableHarmony>
		<EnableModZip>true</EnableModZip>
		<ModZipPath>$(ProjectDir)releases</ModZipPath>
		<EnableModDeploy>true</EnableModDeploy>
	</PropertyGroup>
	<ItemGroup>
	  <Compile Remove="releases\**" />
	  <EmbeddedResource Remove="releases\**" />
	  <None Remove="releases\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Framework\Assets\curlPage.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Framework\Assets\curlPage2.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Framework\Assets\notebook.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Framework\Assets\notebookGrayscale.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Framework\Assets\smallBook.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Framework\Assets\smallBookGrayscale.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="manifest.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	
	<ItemGroup>
		<ContentPacks Include="Content Packs\[CP] Parchment Example Pack" Version="$(Version)" IgnoreModFilePatterns="\.aseprite$" />
	</ItemGroup>
</Project>
